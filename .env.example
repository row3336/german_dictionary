BOT_TOKEN=put-telegram-token-here
DB_PATH=./data/words.db
DUMP_DIR=./data/backups
LOG_PATH=./data/bot.log
SUGGESTIONS_PATH=./data/suggested_words.txt
OPENAI_API_KEY=put-openai-key-here
OPENAI_MODEL=gpt-4.1-nano
OWNER_ID=123456789
# Mini App (miniapp.md §3.3). Off by default: the bot behaves exactly as before.
# The server binds 127.0.0.1 only — nginx is what faces the network.
WEBAPP_ENABLED=0
WEBAPP_PORT=8081
