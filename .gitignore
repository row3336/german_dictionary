.env
.venv/
venv/
__pycache__/
*.pyc

# Local data — contains secrets (e.g. vf_proxy credentials in app_settings).
# The SQLite DB and its dump backups must NEVER be committed.
data/
*.db
*.sqlite
*.sqlite3
*.db-wal
*.db-shm

# Claude Code personal permissions (local, do not commit)
.claude/settings.local.json
.claude/settings.json

# Internal working docs — local only, not versioned (design notes, todo, logs).
# Split from former docs/: claude_docs/ (Claude working notes), project_docs/ (project reference).
claude_docs/
project_docs/

# Local scratch / temp notes — never versioned.
temp.txt
*.tmp
*.scratch
